# Sao chép sang .env.local và điền giá trị thật khi nối backend.

# URL công khai của site (dùng cho metadata / OG / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Search Console & Analytics ---
# Chỉ cần điền là tự bật, không phải sửa code:
# - Search Console: Thêm property → Xác minh khác → thẻ HTML → copy phần content="..." của
#   <meta name="google-site-verification" content="..."> dán vào đây (không cần dấu ngoặc kép).
# - Analytics: tạo luồng dữ liệu Web trong GA4 → lấy Measurement ID dạng G-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Form hợp tác / liên hệ → Google Sheet ---
# URL "Web app" của Google Apps Script gắn vào Sheet đích (Extensions → Apps Script →
# dán doPost() → Deploy → New deployment → Web app → Execute as: Me, Who has access: Anyone
# → copy URL dạng https://script.google.com/macros/s/.../exec). KHÔNG tiền tố NEXT_PUBLIC_ —
# route /api/leads chạy server-side, key không lộ ra trình duyệt.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Backend (thêm khi tích hợp) ---
# DATABASE_URL=
# RESEND_API_KEY=            # gửi email form liên hệ / hợp tác
# CONTACT_INBOX=hello@veagroup.global
# ADMIN_SESSION_SECRET=      # ký session cho /admin
